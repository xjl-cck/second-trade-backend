# IDEA Run Configuration -> Environment variables
DB_USERNAME=root
DB_PASSWORD=填写MySQL密码

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=填写Redis密码
REDIS_DATABASE=2

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=填写RabbitMQ密码
RABBITMQ_SYSTEM_EXCHANGE=system.events
RABBITMQ_SYSTEM_QUEUE=system.notifications
RABBITMQ_SYSTEM_ROUTING_KEY=system.notification
RABBITMQ_DEAD_LETTER_EXCHANGE=platform.dead-letter
RABBITMQ_DEAD_LETTER_QUEUE=platform.dead-letter.queue
RABBITMQ_DEAD_LETTER_ROUTING_KEY=platform.dead-letter
RABBIT_LISTENER_RETRY_MAX_ATTEMPTS=3
RABBIT_LISTENER_RETRY_INITIAL_INTERVAL_MS=1000
RABBIT_LISTENER_RETRY_MAX_INTERVAL_MS=10000
RABBIT_LISTENER_RETRY_MULTIPLIER=2

# outbox 事务消息投递（均有默认值，一般不用改）
OUTBOX_RELAY_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=30
OUTBOX_CONFIRM_TIMEOUT_MS=5000

JWT_SECRET=填写至少32位随机字符串
JWT_EXPIRATION_MINUTES=10080

FAVORITE_REDIS_TTL_SECONDS=1800

# OSS_ENABLED=true 时商品图片使用阿里云 OSS；请填写下面的 OSS 配置
OSS_ENABLED=true
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=填写OSS Bucket名称
OSS_ACCESS_KEY_ID=填写OSS AccessKey ID
OSS_ACCESS_KEY_SECRET=填写OSS AccessKey Secret
OSS_PUBLIC_DOMAIN=https://填写OSS公开域名

# 支付宝沙箱（电脑网站支付）。ALIPAY_ENABLED=false 时仍可用 /api/orders/{id}/pay 模拟支付
ALIPAY_ENABLED=false
ALIPAY_APP_ID=填写沙箱应用 APPID
# 应用私钥：二选一，直接填 PKCS8 内容（换行写成 \n 或用双引号多行），或改用下面的文件路径
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PRIVATE_KEY_PATH=D:\keys\alipay_private_key.txt
ALIPAY_PUBLIC_KEY=填写支付宝公钥（不是应用公钥）
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 异步通知必须是公网可达地址，本地开发用内网穿透把 8081 映射出去后替换这两项
ALIPAY_NOTIFY_URL=http://localhost:8081/api/payments/alipay/notify
ALIPAY_RETURN_URL=http://localhost:8081/api/payments/alipay/return
# 前端支付结果页，留空则由后端直接返回简易结果页
ALIPAY_RETURN_PAGE=
